{
    "name": "smartresponsor/walleting",
    "description": "Symfony-native immutable double-entry walleting component",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.4",
        "doctrine/dbal": "^4.3",
        "doctrine/doctrine-bundle": "^3.0",
        "doctrine/doctrine-migrations-bundle": "^3.4",
        "doctrine/orm": "^3.4",
        "symfony/console": "8.0.*",
        "symfony/doctrine-messenger": "8.0.*",
        "symfony/dotenv": "8.0.*",
        "symfony/flex": "^2.6",
        "symfony/framework-bundle": "8.0.*",
        "symfony/messenger": "8.0.*",
        "symfony/runtime": "8.0.*",
        "symfony/uid": "8.0.*",
        "symfony/yaml": "8.0.*"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.3",
        "symfony/phpunit-bridge": "8.0.*"
    },
    "autoload": {"psr-4": {"App\\": "src/"}},
    "autoload-dev": {"psr-4": {"App\\Tests\\": "tests/"}},
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "test": "phpunit",
        "test:integration": "@php bin/test-integration.php",
        "lint": ["@php bin/console lint:container", "@php bin/console doctrine:schema:validate --skip-sync"]
    },
    "config": {
        "allow-plugins": {"symfony/flex": true, "symfony/runtime": true},
        "sort-packages": true
    },
    "extra": {"symfony": {"allow-contrib": false, "require": "8.0.*"}}
}
